{
  "name": "valuesignal",
  "version": "1.0.14",
  "description": "Turn real AI-assisted work from Cursor, Claude Code, and Codex into a verified builder profile — private by default and shareable as proof of work.",
  "author": {
    "name": "ValueSignal",
    "email": "support@valuesignal.ai"
  },
  "homepage": "https://valuesignal.ai",
  "repository": "https://github.com/ValueSignal/valuesignal-cursor-plugin",
  "license": "MIT",
  "keywords": [
    "valuesignal",
    "ai-fluency",
    "productivity",
    "evidence",
    "logbook"
  ],
  "mcpServers": {
    "valuesignal": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"
      ],
      "env": {
        "VALUESIGNAL_API_BASE": "https://app.valuesignal.ai",
        "VALUESIGNAL_HOST": "claude-code",
        "VALUESIGNAL_JWT_TOKEN": "${VALUESIGNAL_JWT_TOKEN:-}"
      }
    }
  }
}
